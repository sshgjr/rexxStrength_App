# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# ── 시뮬레이터 빌드 시 ML Kit 제거 ──
# EXCLUDE_MLKIT=true 환경변수가 설정되면 .flutter-plugins-dependencies에서
# ML Kit 관련 항목을 제거하여 pod install 시 ML Kit이 포함되지 않도록 합니다.
if ENV['EXCLUDE_MLKIT'] == 'true'
  require 'json'
  # .flutter-plugins-dependencies에서 ML Kit 항목 제거
  deps_file = File.expand_path('../../.flutter-plugins-dependencies', __FILE__)
  if File.exist?(deps_file)
    data = JSON.parse(File.read(deps_file))
    if data['plugins'] && data['plugins']['ios']
      data['plugins']['ios'].reject! { |p| p['name'].to_s.include?('google_mlkit') }
    end
    if data['dependencyGraph']
      data['dependencyGraph'].reject! { |d| d['name'].to_s.include?('google_mlkit') }
    end
    File.write(deps_file, JSON.generate(data))
  end

  # GeneratedPluginRegistrant.m에서 ML Kit import/register 제거
  registrant_file = File.expand_path('Runner/GeneratedPluginRegistrant.m', __dir__)
  if File.exist?(registrant_file)
    lines = File.readlines(registrant_file)
    filtered = []
    skip_block = false
    lines.each do |line|
      # #if 블록에서 google_mlkit이 포함되면 해당 블록 전체 스킵
      if line =~ /^#if.*google_mlkit/
        skip_block = true
        next
      end
      if skip_block
        skip_block = false if line =~ /^#endif/
        next
      end
      # register 호출 줄에서 ML Kit 제거
      next if line =~ /GoogleMlKitCommonsPlugin|GoogleMlKitPoseDetectionPlugin/
      filtered << line
    end
    File.write(registrant_file, filtered.join)
  end
end

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      if ENV['EXCLUDE_MLKIT'] == 'true'
        # ML Kit 제외 빌드: arm64 시뮬레이터 허용
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = ''
      else
        # 기본: ML Kit 포함 빌드 (arm64 시뮬레이터 미지원)
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'arm64'
      end
    end
  end
end
